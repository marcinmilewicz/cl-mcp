{
  "name": "@cl-mcp/core",
  "version": "2.0.0",
  "description": "Transport-agnostic core of cl-mcp: metadata loading (multi-library registry), search/resolution domain, and tool handlers shared by the MCP server and the CLI",
  "keywords": ["mcp", "component-library", "metadata", "angular", "react"],
  "license": "MIT",
  "author": "Marcin Milewicz",
  "homepage": "https://github.com/marcinmilewicz/cl-mcp/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcinmilewicz/cl-mcp.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/marcinmilewicz/cl-mcp/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "@cl-mcp/analyzer": "^2.0.0"
  }
}
