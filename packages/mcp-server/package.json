{
  "name": "@cl-mcp/mcp-server",
  "version": "2.0.0",
  "description": "Universal MCP server for component library metadata (Angular & React)",
  "keywords": ["mcp", "model-context-protocol", "component-library", "metadata", "angular", "react"],
  "license": "MIT",
  "author": "Marcin Milewicz",
  "homepage": "https://github.com/marcinmilewicz/cl-mcp/tree/main/packages/mcp-server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcinmilewicz/cl-mcp.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/marcinmilewicz/cl-mcp/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "cl-mcp-server": "./dist/index.js"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@cl-mcp/core": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.26.0"
  },
  "peerDependencies": {
    "@cl-mcp/analyzer": "^2.0.0"
  }
}
